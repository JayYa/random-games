    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/matter-js": "0.20.2",
    "@types/node": "26.6.6",
    "oxlint": "1.91.0",
    "subset-font": "2.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "matter-js": "0.20.0"
  }
}
